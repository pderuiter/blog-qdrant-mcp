# {{ ansible_managed }}
services:
  qdrant:
    image: {{ qdrant_image }}
    container_name: {{ qdrant_container_name }}
    restart: always
    volumes:
      - qdrant_data:/qdrant/storage
    environment:
      - QDRANT__SERVICE__API_KEY={{ qdrant_api_key }}
      - QDRANT__SERVICE__ENABLE_TLS=false
    networks:
      - {{ qdrant_traefik_network }}
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.qdrant.rule=Host(`{{ qdrant_hostname }}`)"
      - "traefik.http.routers.qdrant.entrypoints={{ qdrant_traefik_entrypoint }}"
      - "traefik.http.routers.qdrant.tls=true"
      - "traefik.http.routers.qdrant.tls.certresolver={{ qdrant_traefik_certresolver }}"
      - "traefik.http.services.qdrant.loadbalancer.server.port=6333"

volumes:
  qdrant_data:

networks:
  {{ qdrant_traefik_network }}:
    external: true
